<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay: allow cleartext (http) traffic so the debug build can talk to a local dev
  server at http://10.0.2.2:9090. The release build is unaffected and stays HTTPS-only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true"/>
</manifest>
